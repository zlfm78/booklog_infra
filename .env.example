# 키 이름만 둔다. `cp .env.example .env` 후 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 사용: set -a; . ./.env; set +a   (현재 셸에 환경 변수로 내보냄)

# ---- 비밀 아님 (③④에서는 ConfigMap) ----
# ①에서 DB_HOST는 127.0.0.1
DB_HOST=
DB_PORT=
DB_NAME=
# 프로세스(Pod)당 연결 풀 크기. Pod 수 × 이 값 ≤ max_connections
DB_POOL_SIZE=
# 로그인 토큰 만료(분). 비우면 60
JWT_EXPIRE_MINUTES=
# 화면·헤더에 표시할 버전 (②부터는 이미지 빌드 시 고정)
APP_VERSION=

# ②(compose.yaml) 이미지 선택. 비우면 로컬 이미지 booklog-was:1.0.0 · booklog-web:1.0.0
# IMAGE_PREFIX는 레지스트리 경로 + / (예: Docker Hub 계정 이름 뒤에 /)
IMAGE_PREFIX=
WAS_VERSION=
WEB_VERSION=

# ---- 비밀 (③④에서는 Secret) ----
# 관리 계정(슈퍼유저): db 컨테이너가 빈 볼륨에서 처음 시작할 때 POSTGRES_*로 생성, migrate(스키마 · 계정 · 시드)가 사용
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
# 앱 계정(슈퍼유저 아님, 테이블 읽기 · 쓰기만): migrate가 app.dbrole로 생성, was가 사용. 관리 계정과 다른 이름
DB_USER=
DB_PASSWORD=
# JWT 서명 키. 모든 was 파드가 같은 값이어야 함. 비우면 프로세스마다 임의 키(경고 출력)
JWT_SECRET=
# 시드의 데모 계정 비밀번호 (8자 이상). 시나리오 verify도 사용
DEMO_PASSWORD=
